# Copy to ".env" in this folder, then restart the HDRI API (uvicorn).
# Shell environment variables still win if already set.

# --- Current architecture: notebook API + public domain + RunComfy GPU ---
# Blender calls https://api.richardandrys.com — notebook runs uvicorn; tunnel gives HTTPS.
# Full steps: ../NOTEBOOK_DOMAIN_SETUP.md
#
# HDRI_PUBLIC_BASE_URL=https://api.richardandrys.com
# HDRI_SIGNING_SECRET=<long-random>
# HDRI_REQUIRE_API_KEY=1
# HDRI_ADMIN_TOKEN=<admin-only>
# HDRI_REMOTE_PROVIDER=runcomfy
# RUNCOMFY_API_TOKEN=...
# RUNCOMFY_DEPLOYMENT_ID=...

# V1 local-first default: external worker (ComfyUI bridge)
PANORAMA_MODE=http_json
PANORAMA_HTTP_URL=http://127.0.0.1:8001/v1/panorama

# Remote provider adapter mode:
# - legacy: use existing PANORAMA_MODE backends (resize/replicate/http_json/hf_dit360)
# - runcomfy: submit and poll hosted RunComfy deployment API
# HDRI_REMOTE_PROVIDER=legacy

# RunComfy hosted workflow provider (used when HDRI_REMOTE_PROVIDER=runcomfy)
# RUNCOMFY_API_TOKEN=
# RUNCOMFY_DEPLOYMENT_ID=
# RUNCOMFY_BASE_URL=https://api.runcomfy.net
# Optional: send full workflow_api_json from local file each request
# RUNCOMFY_WORKFLOW_JSON_PATH=examples/workflow_api.json
# Total wall-clock wait while polling status (queue + GPU cold start + run). Default 900s; use 1800+ if jobs often exceed 15 minutes.
# RUNCOMFY_POLL_TIMEOUT_S=1800
# Per-request HTTP socket timeout (inference POST, each poll, result, downloading output image). Default 120s.
# Raise (e.g. 420) if a single RunComfy HTTP response can take 3–5+ minutes during GPU cold start.
# RUNCOMFY_HTTP_TIMEOUT_S=420
# Optional static per-request overrides baseline
# RUNCOMFY_OVERRIDES_JSON={"12":{"inputs":{"steps":24}}}
# Optional node-id mappings for generic API fields -> workflow inputs
# RUNCOMFY_IMAGE_NODE_IDS=5
# RUNCOMFY_PROMPT_NODE_IDS=17
# RUNCOMFY_NEGATIVE_PROMPT_NODE_IDS=18
# RUNCOMFY_SEED_NODE_IDS=24
# RUNCOMFY_STRENGTH_NODE_IDS=24
# RUNCOMFY_REFERENCE_COVERAGE_NODE_IDS=33
# RUNCOMFY_DIMENSION_NODE_IDS=42
# RUNCOMFY_STEPS_NODE_IDS=24
#
# --- Repo example: examples/comfyui_flux2_klein_4b_api.json (native PanoramaStickers) ---
# Node IDs match the exported API JSON keys. LoadImage feeds PanoramaStickers.sticker_image;
# the API overrides PanoramaStickers.sticker_state with placement_yaw/pitch/scale/rotation.
# RUNCOMFY_WORKFLOW_JSON_PATH=examples/comfyui_flux2_klein_4b_api.json
# RUNCOMFY_IMAGE_NODE_IDS=11
# RUNCOMFY_PANORAMA_STICKERS_NODE_IDS=56
# RUNCOMFY_PANORAMA_STICKERS_USE_EXTERNAL_IMAGE=1
# RUNCOMFY_PANORAMA_STICKER_STATE_INPUT_NAME=sticker_state
# RUNCOMFY_PROMPT_NODE_IDS=6
# RUNCOMFY_NEGATIVE_PROMPT_NODE_IDS=33
# Base ERP outpaint prompt merged with client panorama_prompt (see panorama_prompt.py)
# HDRI_BASE_PANORAMA_PROMPT=Fill the green spaces according to the image...
# HDRI_PROMPT_USER_POSITION=before
# RUNCOMFY_SEED_NODE_IDS=31
# RUNCOMFY_STRENGTH_NODE_IDS=31
# RUNCOMFY_STEPS_NODE_IDS=31
# RUNCOMFY_DEFAULT_REFERENCE_COVERAGE=0.4
# RUNCOMFY_INPUT_IMAGE_TRANSPORT=url
# Max longest edge for JPEG sent to RunComfy LoadImage / sticker_state (default 1536).
# Use 3840 for 4K photos, or 0 / off / none to skip resize (full resolution; larger files).
# RUNCOMFY_INPUT_MAX_EDGE=1536
# Optional: RUNCOMFY_PANORAMA_BG_COLOR=#00ff00
#
# --- 4096x2048 (DEFERRED): 2k outpaint + SeedVR2 upscale — not enabled in v1 ---
# Enable later with HDRI_ENABLE_4K_UPSCALE=1 on the API host and uncomment below.
# RUNCOMFY_4K_WORKFLOW_JSON_PATH=examples/comfyui_flux2_klein_4b_api_4k_upscale.json
# HDRI_ENABLE_4K_UPSCALE=0
# RUNCOMFY_4K_OUTPUT_NODE_IDS=66
# RUNCOMFY_4K_SEEDVR2_DIT_MODEL=seedvr2_ema_3b_fp8_e4m3fn.safetensors
# RUNCOMFY_4K_SEEDVR2_DIT_MODEL_NODE_IDS=69
# RUNCOMFY_4K_SEEDVR2_VAE_MODEL=ema_vae_fp16.safetensors
# RUNCOMFY_4K_SEEDVR2_VAE_MODEL_NODE_IDS=70
# RUNCOMFY_4K_SEEDVR2_RESOLUTION=2048
# RUNCOMFY_4K_SEEDVR2_SEED=42
# RUNCOMFY_4K_SEEDVR2_UPSCALER_NODE_IDS=71

# Job/auth/accounting store
# HDRI_DB_PATH=.\data\state.sqlite3
# Require Bearer API key on /v1/hdri, /v1/jobs/* and /v1/account
# HDRI_REQUIRE_API_KEY=1
# Optional local bootstrap key for development only
# HDRI_BOOTSTRAP_API_KEY=dev-secret-key
# HDRI_BOOTSTRAP_ACCOUNT_ID=dev-account
# HDRI_BOOTSTRAP_TOKENS=25
# Concurrency guard per account for async jobs
# HDRI_MAX_ACTIVE_JOBS_PER_ACCOUNT=2
# Reaper settings for stale jobs (auto-fail + auto-refund)
# HDRI_STALE_REAPER_INTERVAL_S=30
# HDRI_STALE_JOB_TIMEOUT_S=900
# Admin API enablement for account provisioning endpoint POST /v1/accounts
# HDRI_ADMIN_TOKEN=change-me
#
# Self-service registration (Blender add-on: Register account)
# HDRI_REGISTRATION_ENABLED=1
# HDRI_REGISTER_FREE_TOKENS=10
#
# ERP seam fix (API post-process when seam_fix=true in job request)
# Seam fix (when Blender/API seam_fix=true): narrow edge feather only
# HDRI_SEAM_FIX_BAND_FRAC=0.012
# HDRI_SEAM_FIX_BLUR_SIGMA=4
# HDRI_SEAM_FIX_BLEND_STRENGTH=0.35
# HDRI_SEAM_FIX_MASK_POWER=2
#
# Stripe token checkout (set STRIPE_SECRET_KEY to enable billing)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# HDRI_CHECKOUT_SUCCESS_URL=https://api.example.com/docs
# HDRI_CHECKOUT_CANCEL_URL=https://api.example.com/docs
# HDRI_TOKEN_PACKAGES_JSON=[{"id":"tokens_10","label":"10 tokens","tokens":10,"price_cents":900,"currency":"usd"}]
#
# EU/legal compliance for selling digital goods (recommended in production):
# Enable Stripe Tax (auto VAT/sales tax) — requires Tax enabled in Stripe Dashboard.
# HDRI_STRIPE_AUTOMATIC_TAX=1
# Whether listed prices include tax (EU consumer norm) or are exclusive (add at checkout).
# HDRI_STRIPE_PRICE_TAX_BEHAVIOR=inclusive
# Generate an invoice/receipt PDF for every purchase (legal record).
# HDRI_STRIPE_CREATE_INVOICE=1
# Collect business VAT IDs for B2B reverse-charge.
# HDRI_STRIPE_COLLECT_TAX_ID=1

# HDR reconstruction stage after panorama generation
HDR_RECONSTRUCTION_MODE_DEFAULT=comfyui_hdr
# If comfyui_hdr fails or HDR_HTTP_URL is unset, fallback: heuristic | off
HDR_FAILOVER_MODE=heuristic
# Legacy alias for HDR_FAILOVER_MODE
# AI_HDR_FAILOVER_MODE=heuristic
# Local-only: comfyui_hdr -> POST HDR_HTTP_URL -> comfyui_worker.py (:8001) -> ComfyUI GMNet (:8188).
HDR_HTTP_URL=http://127.0.0.1:8001/v1/hdr_restore
# HDR_HTTP_TIMEOUT_S=300
# HDR_HTTP_API_KEY=
# HDR_HTTP_HEADERS_JSON=
# HDR_HTTP_BODY_JSON=

# Optional auth/headers when worker is remote
# PANORAMA_HTTP_API_KEY=
# PANORAMA_HTTP_HEADERS_JSON={"X-Custom":"1"}

# ComfyUI worker env (used by examples/comfyui_worker.py)
# COMFYUI_SERVER_URL=http://127.0.0.1:8188
# COMFYUI_WORKFLOW_TEMPLATE=examples/comfyui_flux2_klein_template.json
# Default HDR = GMNet (no second Flux). For Flux img2img HDR instead: comfyui_flux2_klein_4b_hdr_restore_api.json
# COMFYUI_HDR_WORKFLOW_TEMPLATE=examples/comfyui_gmnet_hdr_restore_api.json
# Optional overrides (prefer values inside exported API workflow JSON)
# COMFYUI_BASE_MODEL=flux-2-klein-base-4b.safetensors
# COMFYUI_KLEIN_LORA=flux-2-klein-4B-360-erp-outpaint-lora\flux-2-klein-4B-360-erp-outpaint-lora_V1.safetensors
# COMFYUI_BALANCED_STEPS=28
# COMFYUI_DEFAULT_STRENGTH=1.0
# COMFYUI_HDR_BALANCED_STEPS=28
# COMFYUI_HDR_DEFAULT_STRENGTH=0.35
# ComfyUI worker panorama post-step: left/right seam blend (default off). Set to 1 to restore old default when seam_fix is omitted.
# COMFYUI_SEAM_FIX_DEFAULT=0

# Alternative provider: Replicate baseline
# PANORAMA_MODE=replicate
# REPLICATE_API_TOKEN=r8_...
# REPLICATE_MODEL_VERSION=5f638558adec78589e947290cb7083b0730dcfc8e8c9c9db6eebc5261edc09ca
# REPLICATE_IMAGE_FIELD=image
